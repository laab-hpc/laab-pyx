#!/bin/bash

#POSTPROCESS_DEPS#

mkdir -p ../../../profiles

pyx-process-logs data.txt --outfile profile.pkl --name "#NAME#" --system "#SYSTEM#" \
    --lib "#LIBRARY#" --version "#VERSION#" --toolchain "#TOOLCHAIN#" \
    --config_path ../../src/config.json --prob_siz "#LAAB_N#" --reps "#LAAB_REPS#" --omp_num_threads "#NCPUS#"

pyx-prepare-md-report profile.pkl --outfile README.md

mv profile.pkl ../../../profiles/profile_#NCPUS#_#CB_ID#.pkl
mv README.md ../../../profiles/README_#NCPUS#_#CB_ID#.md