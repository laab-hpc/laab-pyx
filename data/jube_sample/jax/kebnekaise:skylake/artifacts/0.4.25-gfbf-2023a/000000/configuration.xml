<?xml version="1.0" encoding="UTF-8"?>
<jube version="2.7.1">
  <benchmark name="laab-pyx" file_path_ref="../../.." outpath="..">
    <comment>laab-pyx</comment>
    <parameterset name="param_set" duplicate="replace">
      <parameter name="system" type="string" separator="," duplicate="none" mode="text">kebnekaise:skylake</parameter>
      <parameter name="root" type="string" separator="," duplicate="none" mode="text">/proj/nobackup/aravind/LAAB-HPC/benchmarks/laab-pyx</parameter>
      <parameter name="time_limit" type="string" separator="," duplicate="none" mode="text">00:30:00</parameter>
      <parameter name="ncpus" type="string" separator="," duplicate="none" mode="text">1,4,14</parameter>
      <parameter name="ld_blas" type="string" separator="," duplicate="none" mode="text">'-lopenblas'</parameter>
      <parameter name="laab_reps" type="string" separator="," duplicate="none" mode="text">10</parameter>
      <parameter name="laab_n" type="string" separator="," duplicate="none" mode="text">3000</parameter>
      <parameter name="account_config" type="string" separator="," duplicate="none" mode="text">#SBATCH -A hpc2n2026-184
#SBATCH -C skylake</parameter>
      <parameter name="postprocess_deps" type="string" separator="," duplicate="none" mode="text">module purge
module load GCC/14.3.0 SciPy-bundle
source ${root}/venv/bin/activate</parameter>
      <parameter name="src" type="string" separator="," duplicate="none" mode="text">${root}/src/benchmark_codes/jax/v0-cpu</parameter>
      <parameter name="library" type="string" separator="," duplicate="none" mode="text">jax</parameter>
      <parameter name="version" type="string" separator="," duplicate="none" mode="text">0.4.25</parameter>
      <parameter name="toolchain" type="string" separator="," duplicate="none" mode="text">gfbf-2023a</parameter>
      <parameter name="modules" type="string" separator="," duplicate="none" mode="text">module purge
module load GCC/12.3.0 OpenMPI/4.1.5
module load jax/0.4.25</parameter>
      <parameter name="name" type="string" separator="," duplicate="none" mode="text">CPU-${ncpus}x</parameter>
    </parameterset>
    <substituteset name="substitutes">
      <iofile in="submit.in" out="submit.sh" out_mode="w"/>
      <iofile in="pyx_process_logs.in" out="pyx_process_logs.sh" out_mode="w"/>
      <sub source="#NAME#" mode="text">$name</sub>
      <sub source="#TIME_LIMIT#" mode="text">$time_limit</sub>
      <sub source="#NCPUS#" mode="text">$ncpus</sub>
      <sub source="#ACCOUNT_CONFIG#" mode="text">$account_config</sub>
      <sub source="#MODULES#" mode="text">$modules</sub>
      <sub source="#LD_BLAS#" mode="text">$ld_blas</sub>
      <sub source="#LAAB_REPS#" mode="text">$laab_reps</sub>
      <sub source="#LAAB_N#" mode="text">$laab_n</sub>
      <sub source="#SYSTEM#" mode="text">$system</sub>
      <sub source="#LIBRARY#" mode="text">$library</sub>
      <sub source="#VERSION#" mode="text">$version</sub>
      <sub source="#TOOLCHAIN#" mode="text">$toolchain</sub>
      <sub source="#CB_ID#" mode="text">$jube_benchmark_id</sub>
      <sub source="#POSTPROCESS_DEPS#" mode="text">$postprocess_deps</sub>
    </substituteset>
    <fileset name="files">
      <copy>../../submit.in</copy>
      <copy>../../pyx_process_logs.in</copy>
      <copy target_dir="../../src">${src}/*</copy>
      <copy target_dir="../../src">${src}/../../C</copy>
    </fileset>
    <step name="bm">
      <use>param_set</use>
      <use>files</use>
      <use>substitutes</use>
      <do>sbatch submit.sh</do>
    </step>
  </benchmark>
</jube>
