<?xml version="1.0" encoding="UTF-8"?>
<jube>
  <benchmark name="laab-pyx" outpath="artifacts/2.1.2-foss-2023a">
    <comment>laab-pyx</comment>

    <parameterset name="param_set" init_with="_commons.xml">
      <parameter name="src">${root}/src/benchmark_codes/PyTorch/v2-cpu</parameter>
      <parameter name="library">PyTorch</parameter>
      <parameter name="version">2.1.2</parameter>
      <parameter name="toolchain">foss-2023a</parameter>
      <parameter name="modules">
module purge
module load GCC/12.3.0 OpenMPI/4.1.5
module load PyTorch/2.1.2-CUDA-12.1.1
      </parameter>
      <parameter name="name">CPU-${ncpus}x</parameter>
    </parameterset>

    <include from="_commons.xml" path="files/" />
    <include from="_commons.xml" path="subs/" />

    <step name="bm">
      <include from="_commons.xml" path="steps/" />
    </step>
  </benchmark>
</jube>
